{
  "name": "@releaselens/api",
  "version": "0.0.0",
  "private": true,
  "description": "ReleaseLens HTTP API (NestJS).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",

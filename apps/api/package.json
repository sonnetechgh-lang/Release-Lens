    "@nestjs/throttler": "^6.7.1",
    "@releaselens/contracts": "workspace:*",
    "@releaselens/db": "workspace:*",
    "@releaselens/diagnostics": "workspace:*",
    "@releaselens/integrations": "workspace:*",
    "@releaselens/jobs": "workspace:*",
    "@releaselens/redact": "workspace:*",
    "bullmq": "^6.5.1",
    "cookie-parser": "^1.4.7",
    "express": "5.3.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",

{
  "name": "@releaselens/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database schema, migrations, evidence storage, and demo seed for ReleaseLens.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test-support/external-services.d.ts",
      "default": "./dist/test-support/external-services.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test:integration": "vitest run",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node dist/seed/main.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "@releaselens/contracts": "workspace:*",
    "@releaselens/diagnostics": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@releaselens/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "~7.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}

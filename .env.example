# ReleaseLens environment reference.
# Copy to .env and adjust. Never commit real values.

# ---- Mode ----
# "demo" enables the read-only demo login and synthetic demo data.
# "standard" disables the demo login.
RELEASELENS_MODE=demo

# ---- Database (matches docker-compose.yml) ----
# If port 5432 is taken (e.g. by a local PostgreSQL), set POSTGRES_PORT=5433
# and use the same port in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://releaselens:releaselens@localhost:5432/releaselens

# ---- API ----
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# Session lifetime in hours (default 7 days).
SESSION_TTL_HOURS=168

# ---- Dashboard ----
# Public URL of the dashboard. The API is reached through it at /api.
PUBLIC_URL=http://localhost:3000
# Where the dashboard server reaches the API.
API_INTERNAL_URL=http://127.0.0.1:4000

# ---- GitHub sign-in (optional) ----
# Create an OAuth app at https://github.com/settings/developers with callback URL
#   http://localhost:3000/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated GitHub logins. Owners can sign in and own the primary organization;
# allowed logins can sign in as viewers. Everyone else is refused.
RELEASELENS_OWNER_GITHUB_LOGINS=
RELEASELENS_ALLOWED_GITHUB_LOGINS=
RELEASELENS_ORG_SLUG=default
RELEASELENS_ORG_NAME=My organization

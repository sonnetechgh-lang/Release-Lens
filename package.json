{
  "name": "releaselens",
  "private": true,
  "description": "Deployment intelligence and incident diagnostics: correlates source, CI/CD, cloud deployment, health, and migration evidence.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run build --filter=./packages/* --output-logs=errors-only && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diagnose": "node scripts/diagnose.mjs",
    "dev": "turbo run dev --filter=@releaselens/api --filter=@releaselens/web",
    "test:integration": "turbo run test:integration --concurrency=1",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @releaselens/db migrate:deploy",
    "db:seed": "turbo run build --filter=@releaselens/db... --output-logs=errors-only && pnpm --filter @releaselens/db seed",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "type": "module"
}
